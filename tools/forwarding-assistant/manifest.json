{
  "manifest_version": 3,
  "name": "如如转运助手｜淘宝拼多多物流",
  "version": "0.1.0",
  "description": "识别淘宝和拼多多订单物流、关联商品、复制运单号、标记已转运、跨 Chrome 同步和导出备份。",
  "permissions": [
    "storage",
    "tabs",
    "activeTab"
  ],
  "action": {
    "default_title": "如如转运助手",
    "default_popup": "popup.html"
  },
  "options_page": "dashboard.html",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.taobao.com/*",
        "*://*.tmall.com/*",
        "*://*.pinduoduo.com/*",
        "*://*.yangkeduo.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "key": ""
}

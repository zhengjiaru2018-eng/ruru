{
  "manifest_version": 3,
  "name": "如如转运助手｜淘宝拼多多物流",
  "version": "0.2.1",
  "description": "淘宝与拼多多批量打开订单物流，自动抓取运单、关联商品、一键复制及转运管理",
  "permissions": [
    "storage",
    "tabs",
    "activeTab"
  ],
  "action": {
    "default_title": "如如转运助手",
    "default_popup": "popup.html"
  },
  "options_page": "dashboard.html",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.taobao.com/*",
        "*://*.tmall.com/*",
        "*://*.pinduoduo.com/*",
        "*://*.yangkeduo.com/*"
      ],
      "js": [
        "content.js",
        "crawler.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "key": ""
}
